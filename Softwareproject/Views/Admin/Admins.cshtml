@model List<Softwareproject.Models.Admin>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Adminverwaltung</title>

    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />

    <link
    href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;700&family=Open+Sans:wght@400;700&display=swap"
    rel="stylesheet" />
</head>

<body>

    @if (User.IsInRole("Admin"))
    {
        <partial name="_AdminNavbar" />
    }
    else if (User.IsInRole("Mentor"))
    {
        <partial name="_MentorNavbar" />
    }
    else if (User.IsInRole("Trainee"))
    {
        <partial name="_TraineeNavbar" />
    }
    <p></p>

    @if (TempData["Error"] != null)
    {
        <div class="error-message"> @TempData["Error"] </div>
    }

    <div class="page-content">
    <main class="ruck">
    <a asp-action="Create" class="plan-button">
        Admin hinzufügen
    </a>

    <p></p>

    <!-- GRID -->
    <div class="grid">

        @foreach (var admin in Model)
        {
            <div class="mentor-card">

                <div class="avatar">
                    @admin.Name.Substring(0, 2).ToUpper()
                </div>

                <div class="name">
                    @admin.Name
                </div>

                <div class="role">
                    Administrator
                </div>

                <div class="actions">
                    <div class="action-row">


                        <a asp-action="Edit" asp-route-id="@admin.Id" class="btn primary">
                            Bearbeiten
                        </a>

                        <form asp-action="Delete" asp-route-id="@admin.Id" method="post" class="delete-form"
                              onsubmit="return confirm('⚠️ Administrator löschen?\n\nDiese Aktion kann nicht rückgängig gemacht werden.');">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn danger">
                                Löschen
                            </button>

                        </form>
                    </div>

                </div>

            </div>
        }

    </div>
    </div>
    </main>

</body>

</html>