@model List<Softwareproject.Models.User>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Passwortverwaltung</title>

    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />

    <link
    href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;700&family=Open+Sans:wght@400;700&display=swap"
    rel="stylesheet" />
</head>

<body>

    <partial name="_AdminNavbar" />

    <p></p>

    <div class="page-content">
        <main class="ruck">
            <h1 style="margin-left:40px;">Passwortverwaltung</h1>

            <div class="grid">

                @foreach (var user in Model)
                {
                    var role = user switch
                    {
                        Softwareproject.Models.Admin => "Administrator",
                        Softwareproject.Models.Mentor => "Mentor",
                        Softwareproject.Models.Trainee => "Trainee",
                        _ => "Benutzer"
                    };

                    <div class="mentor-card">

                        <div class="avatar">
                            @(user.Name.Length >= 2
                                ? user.Name.Substring(0, 2).ToUpper()
                                : user.Name.ToUpper())
                        </div>

                        <div class="name">
                            @user.Name
                        </div>

                        <div class="role">
                            @role
                        </div>

                        <div style="margin-top:10px; color:#666;">
                            @user.EmailAddress
                        </div>

                        @if (user.ForgotPassword)
                        {
                            <div style="
                                margin-top:16px;
                                padding:12px;
                                border-radius:12px;
                                background:#fff4d6;
                                border:2px solid #ffc107;
                                color:#8a5b00;
                                font-weight:bold;">
                                ⚠ Dieser Benutzer hat ein neues Passwort angefordert.
                            </div>
                        }

                        <div style="margin-top:20px;">

                            <form asp-action="SetPassword" method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="userId" value="@user.Id" />

                                <input type="hidden" name="role" value="@role" />

                                <input class="form-input" type="password" name="newPassword" placeholder="Neues Passwort" />

                                <p></p>

                                <button type="submit" class="btn primary" style="width:100%;">
                                    Passwort setzen
                                </button>

                            </form>

                        </div>

                        <div style="margin-top:12px;">

                            <form asp-action="LoginAs" method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="userId" value="@user.Id" />

                                <input type="hidden" name="role" value="@role" />

                                <button type="submit" class="btn secondary" style="width:100%;">
                                    Als Benutzer anmelden
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        </div>
    </main>

</body>

</html>