@model Softwareproject.Models.Admin

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/css/adminCreate.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />

    <link
    href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;700&family=Open+Sans:wght@400;700&display=swap"
    rel="stylesheet" />
</head>

<body>
    @if (User.IsInRole("Admin"))
    {
        <partial name="_AdminNavbar" />
    }
    else if (User.IsInRole("Mentor"))
    {
        <partial name="_MentorNavbar" />
    }
    else if (User.IsInRole("Trainee"))
    {
        <partial name="_TraineeNavbar" />
    }
    <p></p>
    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-input" />
        </div>

        <div class="form-group">
            <label asp-for="EmailAddress"></label>
            <input asp-for="EmailAddress" class="form-input" />
        </div>
        <div class="form-group">
            <label>
                <input asp-for="IsActive" />
                Aktiv
            </label>
        </div>

        <button type="submit" class="btn primary">
            Speichern
        </button>

    </form>
</body>