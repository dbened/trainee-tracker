<link
href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap"
rel="stylesheet">
<nav class="navbar">
    <div class="navbar-left">
        <img asp-append-version="true" class="navbar-logo" src="~/images/trainee-tracker-logo.svg" alt="Trainee Tracker Logo" />

        <span class="navbar-title">
            Teaching Platform
        </span>
    </div>

    <div class="navbar-links">

        <a asp-controller="LessonPlan" asp-action="TraineeLessonPlan" asp-route-traineeId="@ViewBag.Trainee.Id">
            Lehrplan
        </a>

        <a asp-controller="WeekPlan" asp-action="TraineeWeekPlan" asp-route-traineeId="@ViewBag.Trainee.Id">
            Wochenplan
        </a>

        <a asp-controller="Request" asp-action="TraineeRequests" asp-route-traineeId="@ViewBag.Trainee.Id">
            Anträge
        </a>

        <a asp-controller="Statistics" asp-action="MentorStatistics" asp-route-traineeId="@ViewBag.Trainee.Id">
            Statistik
        </a>



    </div>

    <div class="navbar-user">

        <span>
            Trainee: @ViewBag.Trainee.Name
        </span>

        <span>
            Mentor: @User.Identity?.Name
        </span>

        <a asp-controller="Login" asp-action="Logout">
            Logout
        </a>

    </div>
</nav>