@model IEnumerable<Softwareproject.Models.LessonPlan>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lehrpläne verwalten</title>
    <link rel="stylesheet" href="~/css/lehrplan.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link
    href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap"
    rel="stylesheet" />
</head>

<body>

    @if (User.IsInRole("Admin"))
    {
        <partial name="_AdminNavbar" />
    }
    else if (User.IsInRole("Mentor"))
    {
        <partial name="_MentorNavbar" />
    }
    else if (User.IsInRole("Trainee"))
    {
        <partial name="_TraineeNavbar" />
    }

    <div class="page-content">
    <main class="ruck">
    <h1>Lehrpläne</h1>

    <div class="plan-header">
        <a asp-action="Import" class="btn secondary">JSON Import</a>
    </div>

    @if (!Model.Any())
    {
        <p style="color:#626262;">Noch keine Lehrpläne vorhanden. Bitte JSON-Datei importieren.</p>
    }

    <div class="plan-container">
        @foreach (var plan in Model)
        {
            var lessonCount = plan.lessonList?.Count(l => !l.IsDeprecated) ?? 0;
            <div class="plan-card">
                <div class="plan-title">@(string.IsNullOrEmpty(plan.Description) ? $"Lehrplan #{plan.Id}" :
                                                                            plan.Description)</div>
                    <div class="plan-info">@lessonCount aktive Lektionen</div>

                    <div class="plan-actions">
                        <a asp-action="LehrplanUebersichtVerwaltung" asp-route-planId="@plan.Id" class="btn primary">Öffnen</a>

                        @if (!plan.IsDeprecated)
                        {
                            <form asp-action="Deactivate" asp-route-id="@plan.Id" method="post" style="display:inline">
                                <button type="submit" class="btn secondary">Deaktivieren</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge">Inaktiv</span>
                        }
                    </div>
                </div>
            }
        </div>
        </div>
    </main>

    </body>

</html>
